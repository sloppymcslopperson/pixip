{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"verbatimModuleSyntax": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["bin", "src", "test", "tools", "eslint.config.js"]
}
