{
	"name": "pixip",
	"version": "0.0.1",
	"private": true,
	"description": "Phone-first web transcript for Pi sessions: a fast supervisor over `pi --mode rpc`",
	"type": "module",
	"bin": {
		"pixip": "./bin/pixip.ts"
	},
	"workspaces": [
		"pi-host"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"start": "node bin/pixip.ts",
		"test": "node --test test/*.test.js test/*.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check --workspace pixip-pi-host",
		"shot": "node tools/shot.mjs"
	},
	"dependencies": {
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.19.0",
		"@types/ws": "^8.5.13",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.2",
		"globals": "^15.15.0",
		"prettier": "^3.10.1",
		"puppeteer-core": "^23.0.0",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.73.0"
	}
}
