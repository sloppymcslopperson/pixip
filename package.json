{
	"name": "pixip",
	"version": "0.0.1",
	"private": true,
	"description": "Phone-first web transcript for Pi sessions: a fast supervisor over `pi --mode rpc`",
	"type": "module",
	"bin": {
		"pixip": "./bin/pixip.ts"
	},
	"workspaces": [
		"pi-host",
		"extensions/*"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"start": "node bin/pixip.ts",
		"test": "node tools/test-run.mjs",
		"test:full": "npm test",
		"test:fast": "node tools/test-run.mjs --fast",
		"typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo/root.tsbuildinfo",
		"lint": "eslint . --cache --cache-location node_modules/.cache/eslint/root.cache",
		"format": "prettier --write .",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css,html}\"",
		"format:docs": "prettier --check \"**/*.md\"",
		"check": "npm run check:static && npm test && npm run check:browser && npm run check:workspaces",
		"check:static": "node tools/check-parallel.mjs",
		"check:fast": "npm run check:static && npm run test:fast",
		"check:workspaces": "node tools/check-workspaces.mjs",
		"check:timings": "node tools/check-timings.mjs",
		"check:imports": "node tools/check-client-imports.mjs",
		"check:browser": "node tools/browser-check.mjs",
		"shot": "node tools/shot.mjs"
	},
	"dependencies": {
		"parse5": "^7.3.0",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@a2ui/lit": "0.15.0",
		"@a2ui/web_core": "0.15.0",
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.19.0",
		"@types/ws": "^8.5.13",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.2",
		"globals": "^15.15.0",
		"prettier": "^3.10.1",
		"puppeteer-core": "^23.0.0",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.73.0"
	}
}
